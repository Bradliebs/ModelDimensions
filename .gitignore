# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
.venv/

# Distribution archives (kept on disk, excluded from the baseline)
*.tar.gz

# Model / HF caches
.cache/
hf_cache/

# Workbench runtime ledger (generated session state; the seed file is tracked)
demos/workbench_ledger.jsonl

# Workbench runtime proposal queue (generated; the seed note is tracked)
demos/workbench_proposals.jsonl

# Workbench runtime knowledge library (generated; the seed doc is tracked)
demos/workbench_knowledge.jsonl

# Review console runtime stores (generated session state; no seed needed)
demos/review_ledger.jsonl
demos/review_proposals.jsonl
demos/review_knowledge.jsonl

# Project pack runtime state (generated on open; manifests and seed files are
# tracked, but the regenerated stores and the active-pack registry are not)
demos/packs/registry.json
demos/packs/*/bank.jsonl
demos/packs/*/ledger.jsonl
demos/packs/*/proposals.jsonl
demos/packs/*/knowledge.jsonl

# Built curated knowledge packs (v1.8): generated from packs/starter specs by
# scripts/build_starter_packs.ps1; the specs are tracked, the built packs are not
packs/built/

# User projects and imported document packs (v7.0): runtime artefacts created
# through the Projects workspace; never committed.
packs/projects/
packs/pdf_imports/

# Value sprint local proposal queue (v2.5B): the report tables
# (reports/value_sprint_latest.{md,jsonl}) are tracked, but the opt-in
# proposal queue is regenerated locally and is not.
reports/value_sprint_proposals.jsonl

