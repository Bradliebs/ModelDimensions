# EXAMPLE ONLY — DISABLED BY DEFAULT.
#
# This is a guarded template for a *medical* knowledge pack. It is shipped with
# the `.example` suffix and `enabled: false` so the build script never builds it
# automatically. Medical content carries domain-safety rules: every answer is
# flagged informational-only (not advice, not a diagnosis, not a prescription),
# and the matching eval file requires that flag before the pack is trusted.
#
# To use this responsibly:
#   1. Provide your own licensed, reputable local source document.
#   2. Copy this file to `medical_reference_pack.yaml` (drop `.example`).
#   3. Set `enabled: true` and point `path_or_url` at your local file.
#   4. Build it, then run demos/pack_eval_questions/medical_reference_eval.jsonl
#      (copied from the .example) and confirm the informational_only flag passes.
#
# URL ingestion stays disabled: medical sources must be reviewed locally first.

pack_name: medical-reference
description: EXAMPLE guarded medical reference pack (disabled by default).
default_domain: medical
default_knowledge_backend: deterministic
allow_url_ingestion: false
enabled: false

sources:
  - source_name: Medical Reference (example)
    path_or_url: packs/starter/sources/medical_reference.example.md
    domain: medical
    authority: reputable
    version: "example"
    licence: PROVIDE-YOUR-OWN
    staleness_policy: review-quarterly
